# Frontend environment template. Copy to .env.local.
# Only VITE_* values are exposed to the browser. Never put AWS credentials here.

# Use "api" for the FastAPI/Bedrock pipeline or "mock" for local fixtures.
VITE_DATA_SOURCE=api
VITE_API_URL=http://localhost:8000

# Development identity only. The current backend accepts this through X-User-ID.
VITE_DEV_USER_ID=career-craft-local-demo
