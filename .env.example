# Backend environment template. Copy to .env and replace placeholders.
# Never commit .env or put these values in the frontend.

# Supabase (optional for local in-memory mode)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Amazon Bedrock authentication.
# Use either a short-term bearer token OR the AWS IAM values below.
# A short-term token is region-specific and expires (maximum 12 hours).
AWS_BEARER_TOKEN_BEDROCK=your-bedrock-bearer-token

# AWS IAM alternative (leave blank when using the bearer token).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Backend settings
FRONTEND_ORIGIN=http://localhost:5173
MAX_UPLOAD_SIZE_BYTES=10485760
